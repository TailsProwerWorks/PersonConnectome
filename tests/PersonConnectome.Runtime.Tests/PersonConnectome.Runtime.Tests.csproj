<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>none</AnalysisLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0649;CS7022;CS8632</NoWarn>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive; compile</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.MTP" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive; compile</IncludeAssets>
    </PackageReference>
    <Compile Include="../../src/Core/ConnectomeAsset.cs" Link="src/Core/ConnectomeAsset.cs" />
    <Compile Include="../../src/Core/ConnectomeAssetReader.cs" Link="src/Core/ConnectomeAssetReader.cs" />
    <Compile Include="../../src/Core/LifBrainFactory.cs" Link="src/Core/LifBrainFactory.cs" />
    <Compile Include="../../src/Core/IBodyActuator.cs" Link="src/Core/IBodyActuator.cs" />
    <Compile Include="../../src/Core/IBodySensor.cs" Link="src/Core/IBodySensor.cs" />
    <Compile Include="../../src/Core/LifBrain.cs" Link="src/Core/LifBrain.cs" />
    <Compile Include="../../src/Core/MotorCommand.cs" Link="src/Core/MotorCommand.cs" />
    <Compile Include="../../src/Core/SensoryFrame.cs" Link="src/Core/SensoryFrame.cs" />
    <Compile Include="../../src/UI/ManualInputState.cs" Link="src/UI/ManualInputState.cs" />
    <Compile Include="../../src/UI/BrainMap.cs" Link="src/UI/BrainMap.cs" />
    <Compile Include="../../src/UI/TelemetryLayout.cs" Link="src/UI/TelemetryLayout.cs" />
  </ItemGroup>
</Project>
