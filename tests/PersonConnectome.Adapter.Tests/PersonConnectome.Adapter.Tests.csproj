<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <!-- Game doubles intentionally model Unity's nullable-at-runtime API while
         accepting annotations in linked sources. -->
    <NoWarn>$(NoWarn);CS0649;CS8632</NoWarn>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive; compile</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.MTP" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive; compile</IncludeAssets>
    </PackageReference>
    <Compile Include="../../src/Adapters/PeoplePlaygroundPersonAdapter.cs" Link="src/Adapters/PeoplePlaygroundPersonAdapter.cs" />
    <Compile Include="../../src/Adapters/PersonMotorCommand.cs" Link="src/Adapters/PersonMotorCommand.cs" />
    <Compile Include="../../src/Adapters/PersonObservation.cs" Link="src/Adapters/PersonObservation.cs" />
    <Compile Include="../../src/Adapters/PersonStandingController.cs" Link="src/Adapters/PersonStandingController.cs" />
    <Compile Include="../../src/Adapters/PersonTrainingSession.cs" Link="src/Adapters/PersonTrainingSession.cs" />
    <Compile Include="../../src/Adapters/PersonConnectomeLimbController.cs" Link="src/Adapters/PersonConnectomeLimbController.cs" />
    <Compile Include="../../src/Adapters/PersonConnectomeLimbProbe.cs" Link="src/Adapters/PersonConnectomeLimbProbe.cs" />
    <Compile Include="../../src/Adapters/LiquidAndStatusReader.cs" Link="src/Adapters/LiquidAndStatusReader.cs" />
    <Compile Include="../../src/Adapters/PeoplePlaygroundFlyAdapter.cs" Link="src/Adapters/PeoplePlaygroundFlyAdapter.cs" />
    <Compile Include="../../src/Mod/PersonConnectomeController.cs" Link="src/Mod/PersonConnectomeController.cs" />
    <Compile Include="../../src/Core/IBodyActuator.cs" Link="src/Core/IBodyActuator.cs" />
    <Compile Include="../../src/Core/IBodySensor.cs" Link="src/Core/IBodySensor.cs" />
    <Compile Include="../../src/Core/FlyMotorCommand.cs" Link="src/Core/FlyMotorCommand.cs" />
    <Compile Include="../../src/Core/ConnectomeLearningMode.cs" Link="src/Core/ConnectomeLearningMode.cs" />
    <Compile Include="../../src/Core/SensoryFrame.cs" Link="src/Core/SensoryFrame.cs" />
    <Compile Include="../../src/UI/ManualInputState.cs" Link="src/UI/ManualInputState.cs" />
  </ItemGroup>
</Project>
